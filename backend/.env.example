# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# NOTE: nothing in the Node process loads this file. There is no dotenv
# dependency and no `env_file` in docker-compose.yml. It is the template for
# the `.env` the *deployed host* holds (seeded from SSM Parameter Store), and a
# checklist of every variable the code reads. For local development the
# defaults in backend/knexfile.ts and backend/src/services/storage.ts already
# match the compose stack, so `npm run dev` works with none of this exported.
# To override one locally, export it in your shell.

# ── Database ────────────────────────────────────────────────────────
# Must match docker-compose.yml's `db` service. It previously read
# commwatch:commwatch-secret, which are the MinIO credentials and have never
# been the Postgres ones — anyone who exported this file got a password
# failure against a database that was running fine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commissionwatch

# ── Object storage (MinIO) ──────────────────────────────────────────
# These four are what backend/src/services/storage.ts actually reads. The
# S3_* names below them are not read by anything in backend/src.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=commwatch
MINIO_SECRET_KEY=commwatch-secret
MINIO_BUCKET=meeting-documents

# ── Server ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Delivery channels (W7) ──────────────────────────────────────────
# Encrypts webhook URLs at rest in delivery_channels.config_encrypted.
# Generate with: openssl rand -hex 32
CHANNEL_SECRET_KEY=

# Shared secret CI presents to POST /api/internal/events.
# Generate with: openssl rand -hex 32
CI_EVENT_TOKEN=

# Direct Discord webhook, used ONLY as the CI fallback when the backend
# cannot be reached — a broken deploy must still be able to page you.
# Normal delivery is configured by the operator in the admin UI, not here.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/ME

# Campaign finance. Free key from https://api.data.gov/signup/ — the DEMO_KEY
# ceiling is 10 requests per window and must not be used outside a scratch
# probe. Registered keys allow 1,000/hour, which is the 3.6s default interval.
OPENFEC_API_KEY=

# Operator authentication. The admin surface is closed without a session.
# Comma-separated origins allowed to make credentialed requests to /api/admin.
# The public read-only API stays open to any origin regardless.
ADMIN_ORIGINS=https://commissionwatch.bmux.sh,http://localhost:3000
# Leave unset: Secure defaults on when NODE_ENV=production and off otherwise,
# because a Secure cookie over plain http in dev is silently never stored.
SESSION_COOKIE_SECURE=
# The first operator, seeded once at boot and only while `operators` is empty.
# Delivered by the host from SSM Parameter Store like every other secret here.
# Clear these after the first boot — leaving them set does nothing except keep
# a password sitting in the environment.
OPERATOR_SEED_EMAIL=
OPERATOR_SEED_PASSWORD=
OPERATOR_SEED_NAME=

# SMS delivery (B-e). Absent, SMS channels exist but cannot send and say so on
# the delivery row rather than failing silently.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The public origin Twilio signs its inbound webhook against. Behind Caddy the
# request arrives as plain http on an internal hop, so this cannot be
# reconstructed from the request — a reconstructed http:// URL never matches a
# signature computed over https://.
PUBLIC_BASE_URL=https://commissionwatch.bmux.sh
