IMAGE_BACKEND=localhost:5000/commissionwatch-backend:latest
IMAGE_FRONTEND=localhost:5000/commissionwatch-frontend:latest
DATABASE_URL=postgres://commwatch:CHANGE_ME@commissionwatch-db:5432/commwatch
POSTGRES_USER=commwatch
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=commwatch
MINIO_ACCESS_KEY=commwatch
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=meeting-documents

# ── First operator ───────────────────────────────────────────────────────────
# Seeds the one operator account for /admin. There is no registration route by
# design, so without these the console is deployed and unenterable. Seeding is
# a no-op once the operators table is non-empty, so these can be cleared after
# the first successful boot. Set them in /commissionwatch/env (Parameter Store),
# never here.
OPERATOR_SEED_EMAIL=
OPERATOR_SEED_PASSWORD=
OPERATOR_SEED_NAME=
