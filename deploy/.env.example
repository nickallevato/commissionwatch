IMAGE_BACKEND=localhost:5000/commissionwatch-backend:latest
IMAGE_FRONTEND=localhost:5000/commissionwatch-frontend:latest
DATABASE_URL=postgres://commwatch:CHANGE_ME@commissionwatch-db:5432/commwatch
POSTGRES_USER=commwatch
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=commwatch
MINIO_ACCESS_KEY=commwatch
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=meeting-documents

# ── First operator ───────────────────────────────────────────────────────────
# Seeds the one operator account for /admin. There is no registration route by
# design, so without these the console is deployed and unenterable. Seeding is
# a no-op once the operators table is non-empty, so these can be cleared after
# the first successful boot. Set them in /commissionwatch/env (Parameter Store),
# never here.
# ── Prerendering ─────────────────────────────────────────────────────────────
# Off unless set. On, the backend writes a static HTML document per public
# record into the commissionwatch-prerender volume, and the web container serves
# it to crawlers. See docs/STATUS.md for the two-step operator procedure — the
# flag alone renders nothing that was published before it was set.
PRERENDER_ENABLED=

# ── Feature registry ─────────────────────────────────────────────────────────
# As of 0.4.0 features are toggled from /admin/features, and the toggle is
# recorded with the operator who made it and their stated reason. The three
# legacy variables above and below (PRERENDER_ENABLED, EVENT_DRAIN_ENABLED,
# MCP_ENABLED) still work and still mean what they meant — with no row in the
# `features` table, resolution is byte-identical to 0.3.0.
#
# What these add is a KILL SWITCH, and it is one-directional. FEATURE_<KEY>
# set to false/0/no/off forces that feature off no matter what the database
# says, and the console cannot override it — it renders the control disabled
# and names this variable as the reason. Setting one to `true` enables
# NOTHING and logs that the variable has no on position: forcing a feature on
# from the environment is the untraceable enable the registry exists to remove.
#
# The kill switch outranks the database on purpose. The case that most demands
# turning a feature off is the one where the feature is hammering Postgres, and
# a switch that needs a healthy Postgres to say "stop" does not work when it
# matters. This one needs no query and survives a restart.
#
# Keys: FEATURE_EVENT_DRAIN, FEATURE_PRERENDER, FEATURE_MCP_SERVER,
# FEATURE_DATED_EXPORT_ARCHIVE. All unset by default — unset is not a kill
# switch, it simply declines to override.
#
# FEATURE_CLAIM_PUBLICATION and FEATURE_GENERATED_NARRATIVE were listed here
# until 0.5.0 removed both keys from the manifest for having no reader in
# `backend/src`. Setting either now does nothing; an unresolvable key is inert.
FEATURE_EVENT_DRAIN=

# How often each process re-reads the features table, in milliseconds.
# Default 5000. A toggle takes up to this long to reach a process that did not
# serve the request that made it; the console states the skew rather than
# implying the switch is instant.
FEATURE_POLL_INTERVAL_MS=

OPERATOR_SEED_EMAIL=
OPERATOR_SEED_PASSWORD=
OPERATOR_SEED_NAME=
